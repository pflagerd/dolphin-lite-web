#!/usr/bin/env bash
set -e

INVOKE_DIR="$PWD"   # capture before cd changes it

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ── 1. Resolve start directory ────────────────────────────────────────────────
if [ -n "$1" ] && [ -d "$1" ]; then
  export START_DIR="$(cd "$1" && pwd)"
else
  export START_DIR="$INVOKE_DIR"
fi

# ── 2. Ensure environment is ready ───────────────────────────────────────────
"$SCRIPT_DIR/setmeup"
echo ""

# ── 3. Pick a random free unprivileged port (3000–9999) ──────────────────────
# A port counts as taken if something accepts a TCP connection on it (bash's
# /dev/tcp, so no extra dependency such as nc). There is an unavoidable race:
# another process could grab the port between this check and the server
# binding it. Step 6 catches that case, because it only accepts an answer that
# carries this launch's ID.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}
PORT=""
for (( try = 0; try < 50; try++ )); do
  candidate=$(( RANDOM % 7000 + 3000 ))
  if ! port_in_use "$candidate"; then
    PORT=$candidate
    break
  fi
done
if [ -z "$PORT" ]; then
  echo "❌  Could not find a free port in 3000–9999 after 50 tries."
  exit 1
fi
export PORT
URL="http://localhost:${PORT}"

# Per-launch ID: /api/ping echoes it back, so step 6 can tell this server
# apart from anything else that might answer on the same port.
if [ -r /proc/sys/kernel/random/uuid ]; then
  DLW_LAUNCH_ID="$(cat /proc/sys/kernel/random/uuid)"
else
  DLW_LAUNCH_ID="${RANDOM}${RANDOM}${RANDOM}$$"
fi
export DLW_LAUNCH_ID

echo "🐬 Dolphin Lite Web — starting"
echo "────────────────────────────"
echo "  Dir  : ${START_DIR}"
echo "  Port : ${PORT}"
echo "  URL  : ${URL}"
echo ""

# ── 4. Read saved window geometry from .dolphin-lite-web.json ─────────────────────
WIN_W=1280; WIN_H=900; WIN_X=0; WIN_Y=0
SETTINGS_FILE="$START_DIR/.dolphin-lite-web.json"
if [ -f "$SETTINGS_FILE" ]; then
  read -r WIN_W WIN_H WIN_X WIN_Y < <(
    SETTINGS_PATH="$SETTINGS_FILE" node -e "
      const fs = require('fs');
      try {
        const d = JSON.parse(fs.readFileSync(process.env.SETTINGS_PATH, 'utf8'));
        const w = d.window || {};
        process.stdout.write([(w.w||1280),(w.h||900),(w.x||0),(w.y||0)].join(' ') + '\n');
      } catch(e) { process.stdout.write('1280 900 0 0\n'); }
    "
  ) || true
fi

# ── 5. Start server via nodemon (background) ─────────────────────────────────
"$SCRIPT_DIR/node_modules/.bin/nodemon" \
  --watch "$SCRIPT_DIR/server.js" \
  --watch "$SCRIPT_DIR/index.html" \
  "$SCRIPT_DIR/server.js" &
NODEMON_PID=$!

# ── 6. Poll until THIS server answers (matching launch ID), max ~20 s ────────
WAIT_TIMEOUT=20
echo -n "  Waiting for server"
deadline=$(( SECONDS + WAIT_TIMEOUT ))
until [[ "$(curl -sf --max-time 1 "http://localhost:${PORT}/api/ping" 2>/dev/null)" \
         == *"\"launchId\":\"${DLW_LAUNCH_ID}\""* ]]; do
  if (( SECONDS >= deadline )); then
    echo " timed out."
    echo "❌  Server did not respond on port ${PORT} within ${WAIT_TIMEOUT}s (see output above)."
    pkill -TERM -P "$NODEMON_PID" 2>/dev/null || true   # node child of nodemon
    kill -TERM "$NODEMON_PID" 2>/dev/null || true
    wait "$NODEMON_PID" 2>/dev/null || true
    exit 1
  fi
  echo -n "."
  sleep 0.2
done
echo " ready."
echo ""

# ── 7. Launch Chrome ─────────────────────────────────────────────────────────
# activity-google-chrome is assumed to be a local wrapper around Chrome (not a
# standard binary); the fallbacks below are used when it is not on PATH.
CHROME_FLAGS="--app=${URL} --new-window --window-size=${WIN_W},${WIN_H} --window-position=${WIN_X},${WIN_Y}"
if command -v activity-google-chrome &>/dev/null; then
  activity-google-chrome $CHROME_FLAGS &
elif command -v google-chrome &>/dev/null; then
  echo "⚠️  activity-google-chrome not found — falling back to google-chrome"
  google-chrome $CHROME_FLAGS &
elif command -v chromium-browser &>/dev/null; then
  echo "⚠️  activity-google-chrome not found — falling back to chromium-browser"
  chromium-browser $CHROME_FLAGS &
elif command -v chromium &>/dev/null; then
  # Debian, Fedora and Arch name the binary "chromium"
  echo "⚠️  activity-google-chrome not found — falling back to chromium"
  chromium $CHROME_FLAGS &
elif command -v xdg-open &>/dev/null; then
  # Default browser; no app-window mode or saved geometry
  echo "⚠️  No Chrome/Chromium found — opening ${URL} in the default browser"
  xdg-open "$URL" &
else
  echo "⚠️  No browser launcher found. Open ${URL} manually."
fi

# ── 8. Wait on nodemon (keeps shell occupied; exits when server shuts down) ──
wait $NODEMON_PID
